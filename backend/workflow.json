    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || {}\n\nlet answers\ntry {\n  answers = typeof body.answers === 'string'\n    ? JSON.parse(body.answers)\n    : body.answers\n} catch {\n  throw new Error('body.answers deve ser um JSON válido.')\n}\n\nif (!Array.isArray(answers) || answers.length === 0) {\n  throw new Error('body.answers deve ser uma lista de respostas.')\n}\n\nreturn answers.map((item, index) => ({\n  json: {\n    questionId: item.questionId ?? index + 1,\n    question: item.question || '',\n    answer: item.answer || '',\n  },\n}))"
      },
      "id": "229d7747-b589-4dbe-b5e5-43c52bccb76b",
      "name": "Split Answers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -448,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const answers = $input.all().map(({ json }) => ({\n  questionId: json.questionId,\n  question: json.question,\n  answer: json.answer,\n}))\n\nconst body = $('Webhook').first().json.body || {}\n\nif (!body.chapter?.trim()) {\n  throw new Error('body.chapter é obrigatório para avaliar as respostas.')\n}\n\nreturn [{\n  json: {\n    chapter: body.chapter || '',\n    qa: JSON.stringify(answers, null, 2),\n  },\n}]"
      },
      "id": "7411c37f-cf15-4e00-8453-587c7c946520",
      "name": "Pair Questions And Answers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -224,
        400
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an expert examiner. Using the book chapter as the ground truth, evaluate each transcribed spoken answer. For every question give a score from 0 to 10, a max_score of 10, and concise constructive feedback. Then give an overall_score, overall_max, and a short summary.\n\nWrite every human-readable field in {{ ({ pt: 'Portuguese', es: 'Spanish', en: 'English' }[String($('Webhook').first().json.body?.locale || '').toLowerCase().split(/[-_]/)[0]]) || 'English' }}: expectedAnswer, feedback, and summary. This is mandatory even when the chapter, questions, or answers are in another language.\n\n=== CHAPTER (ground truth) ===\n{{ $json.chapter }}\n\n=== QUESTIONS AND TRANSCRIBED ANSWERS (JSON) ===\n{{ $json.qa }}",
        "hasOutputParser": true,
        "batching": {}
      },
      "id": "7361bb9f-15c6-4fbb-8c10-946a78e67536",
      "name": "Evaluate Answers",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        0,
        400
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"answers\": [\n    {\n      \"questionId\": 1,\n      \"score\": 0,\n      \"max_score\": 10,\n      \"expectedAnswer\": \"string\",\n      \"feedback\": \"string\"\n    }\n  ],\n  \"overall_score\": 0,\n  \"overall_max\": 0,\n  \"summary\": \"string\"\n}"
      },
      "id": "4dfb755b-c474-4a79-843d-e4dbf3bef284",
      "name": "Evaluation Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
